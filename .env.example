# EmailJS — https://www.emailjs.com/
# Required for the contact form to send emails.
# Set these in your Vercel dashboard (Settings → Environment Variables) or in .env.local for local dev.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# The form sends {{name}}, {{email}}, {{message}} and {{timestamp}},
# matching the template used by vikramguntuka-portfolio.
